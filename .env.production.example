# Copy to .env.production on the server. Never commit .env.production.
# Generate secrets with: openssl rand -hex 32

# Your domain, without https:// (point its A record at the VPS IP first)
DOMAIN=ghanawatch.example.org
PUBLIC_ORIGIN=https://ghanawatch.example.org

# Database password (used by both the db container and the app)
POSTGRES_PASSWORD=
# Limited database account used by the website (rows only). openssl rand -hex 32
APP_DB_PASSWORD=

# 32+ random characters
APP_SECRET=

# First administrator; must change password at first login
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Optional live sources that need a free key
# Optional, Ground view: Mapillary street-level photos, and Google Street View opened inside the site

NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_SIGHTINGS_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_MIN=5

# Galamsey detector: legacy (the two-date scan) until deploy/console-backfill.sh has built the monthly record,
# then multisensor (detector 3.0). Run deploy/console-update.sh after changing it.
GW_DETECTOR=legacy
