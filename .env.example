# Copy to .env.local for local development. Never commit .env.local.

# Leave DATABASE_URL empty to use the embedded PGlite database in DATA_DIR (no install needed).
# For production use Postgres 15+ with PostGIS, e.g. postgres://user:pass@host:5432/ghanawatch
DATABASE_URL=
DATA_DIR=.data

# At least 32 random characters; the app refuses to start with a placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Administrator seeded on first run; must change password at first login.
ADMIN_EMAIL=admin@ghanawatch.local
ADMIN_INITIAL_PASSWORD=

# Public origin used in exports, citations and the sitemap.
PUBLIC_ORIGIN=http://localhost:3000

# Optional provider keys. Adapters without a key fall back to bundled fixtures.
FIRMS_MAP_KEY=
GFW_API_KEY=
# Optional, Ground view street-level photos: Mapillary client token, and a Google Maps key
# (Street View Static metadata + Maps Embed APIs) to open Street View inside the site.
MAPILLARY_TOKEN=
GOOGLE_MAPS_API_KEY=

# Vector basemap style (MapLibre). OpenFreeMap is free with attribution; a self-hosted PMTiles style can replace it.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Rate limits (per address). "Heavy" covers land checks, satellite comparisons and rendered pictures.
RATE_LIMIT_PUBLIC_PER_MIN=120
RATE_LIMIT_HEAVY_PER_MIN=10
RATE_LIMIT_REPORTS_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_MIN=5

# The monthly release and weekly digest (all optional; without them the site works, mail and DOIs are skipped).
# Brevo transactional email (free tier) for the weekly digest and subscription confirmations.
BREVO_API_KEY=
MAIL_FROM=GhanaWatch <alerts@example.org>
# Link to the WhatsApp channel, shown on /alerts.
WHATSAPP_CHANNEL_URL=
# Zenodo personal access token with deposit scope; ZENODO_SANDBOX=1 to test against the sandbox.
ZENODO_TOKEN=
ZENODO_SANDBOX=
